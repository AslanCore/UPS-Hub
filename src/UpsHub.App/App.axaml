<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UpsHub.App.App"
             RequestedThemeVariant="Dark"
             Name="UPS Hub">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://UpsHub/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://UpsHub/Styles/Icons.axaml" />
        <ResourceInclude Source="avares://UpsHub/Styles/SharedTemplates.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Switches and check boxes use the accent when on, with a dark knob / tick for contrast -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF5C1A" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF7336" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#E04E12" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF5C1A" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF7336" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#E04E12" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#111111" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#111111" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#111111" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FF5C1A" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FF7336" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#E04E12" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FF5C1A" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#FF7336" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#E04E12" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#111111" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#111111" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#111111" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Fluent 2 shape: 4px controls, 8px flyouts -->
      <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI Variable, Segoe UI, Inter, sans-serif</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Neutral Windows 11 dark greys; the accent is the only colour -->
        <ColorPaletteResources x:Key="Dark"
                               Accent="#FF5C1A"
                               RegionColor="#202020"
                               AltHigh="#202020" AltLow="#202020" AltMedium="#202020" AltMediumHigh="#202020" AltMediumLow="#202020"
                               BaseHigh="#FFFFFF" BaseLow="#333333" BaseMedium="#9D9D9D" BaseMediumHigh="#C5C5C5" BaseMediumLow="#6E6E6E"
                               ChromeAltLow="#C5C5C5" ChromeBlackHigh="#000000" ChromeBlackLow="#C5C5C5" ChromeBlackMedium="#000000"
                               ChromeBlackMediumLow="#000000" ChromeDisabledHigh="#333333" ChromeDisabledLow="#6E6E6E" ChromeGray="#9D9D9D"
                               ChromeHigh="#3A3A3A" ChromeLow="#1C1C1C" ChromeMedium="#272727" ChromeMediumLow="#2D2D2D"
                               ChromeWhite="#FFFFFF" ListLow="#2D2D2D" ListMedium="#333333" ErrorText="#FF6B6B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://UpsHub/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
