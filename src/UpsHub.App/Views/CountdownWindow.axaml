<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UpsHub.App.ViewModels"
        xmlns:c="using:UpsHub.App.Controls"
        x:Class="UpsHub.App.Views.CountdownWindow"
        x:DataType="vm:CountdownViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://UpsHub/Assets/upshub.ico"
        Width="460" Height="300" CanResize="False" Topmost="True" ShowInTaskbar="True"
        SystemDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">
  <Border Margin="0" Background="#2C2C2C" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
    <StackPanel Margin="28,24,28,24" Spacing="14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Data="{StaticResource IconPower}" Width="16" Height="16" Foreground="{StaticResource StatusDownBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Kicker}" Classes="kicker" VerticalAlignment="Center" Margin="10,0,0,0" />
        <Border Grid.Column="2" Classes="badge" Margin="0" IsVisible="{Binding IsTest}">
          <TextBlock Text="{Binding TestBadge}" />
        </Border>
      </Grid>

      <StackPanel Spacing="4" HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Heading}" Classes="display" FontSize="20" />
        <TextBlock Text="{Binding TimeText}" Classes="value" FontSize="48" Margin="0,10,0,6" />
        <c:MeterBar Minimum="0" Maximum="100" Value="{Binding Progress}" BarBrush="{StaticResource PrimaryBrush}" />
      </StackPanel>

      <TextBlock Text="{Binding Reason}" Classes="muted" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,8,Auto,*,Auto" Margin="0,6,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}" />
        <Button Grid.Column="2" Content="{Binding ExtendText}" Command="{Binding ExtendCommand}" IsVisible="{Binding CanExtend}" />
        <Button Grid.Column="4" Classes="primary" Content="{Binding NowText}" Command="{Binding NowCommand}" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
