<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UpsHub.App.ViewModels"
        xmlns:v="using:UpsHub.App.Views"
        x:Class="UpsHub.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding AppName}"
        Icon="avares://UpsHub/Assets/upshub.ico"
        Width="1180" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel"><v:DashboardView /></DataTemplate>
    <DataTemplate DataType="vm:ServersViewModel"><v:ServersView /></DataTemplate>
    <DataTemplate DataType="vm:ShutdownViewModel"><v:ShutdownView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="248,*" RowDefinitions="32,*">
    <!-- ===== Title bar (custom chrome, Windows 11 proportions: 32px, 46px caption buttons) ===== -->
    <Border x:Name="TitleBar" Grid.ColumnSpan="2" ZIndex="20" Background="{StaticResource BgBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border x:Name="BrandBar" Background="Transparent" Padding="16,0,12,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
            <PathIcon Data="{StaticResource IconBattery}" Width="16" Height="16" Foreground="{StaticResource ForegroundBrush}" />
            <TextBlock Text="{Binding AppName}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
            <TextBlock x:Name="Crumb" IsVisible="False" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="badge" Margin="0" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" IsVisible="{Binding IsDemo}">
          <TextBlock Text="Demo · simulated UPS" />
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Classes="caption" x:Name="MinButton" ToolTip.Tip="Minimize"><PathIcon Data="{StaticResource CapMin}" /></Button>
          <Button Classes="caption" x:Name="MaxButton" ToolTip.Tip="Maximize"><PathIcon Data="{StaticResource CapMax}" /></Button>
          <Button Classes="caption close" x:Name="CloseButton" ToolTip.Tip="Close to tray"><PathIcon Data="{StaticResource CapClose}" /></Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Navigation (Settings-app style) ===== -->
    <Border Grid.Row="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="*,Auto">
        <StackPanel Margin="8,4,8,0" Spacing="2">
          <Button Classes="nav" Classes.active="{Binding IsDashboard}" Command="{Binding NavigateCommand}" CommandParameter="dashboard">
            <StackPanel Orientation="Horizontal"><PathIcon Data="{StaticResource IconDashboard}" /><TextBlock Text="Dashboard" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsServers}" Command="{Binding NavigateCommand}" CommandParameter="servers">
            <StackPanel Orientation="Horizontal"><PathIcon Data="{StaticResource IconServer}" /><TextBlock Text="Servers" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsShutdown}" Command="{Binding NavigateCommand}" CommandParameter="shutdown">
            <StackPanel Orientation="Horizontal"><PathIcon Data="{StaticResource IconPower}" /><TextBlock Text="Shutdown rules" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsSettings}" Command="{Binding NavigateCommand}" CommandParameter="settings">
            <StackPanel Orientation="Horizontal"><PathIcon Data="{StaticResource IconSettings}" /><TextBlock Text="Settings" /></StackPanel>
          </Button>

          <TextBlock Text="Monitored UPS" FontSize="12" FontWeight="Medium" Foreground="{StaticResource SubtleBrush}" Margin="8,18,0,6" IsVisible="{Binding !!SidebarUps.Count}" />
          <ItemsControl ItemsSource="{Binding SidebarUps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SidebarUpsViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="8,0,8,0" Height="48">
                  <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Host}" Foreground="{StaticResource SubtleBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Value}" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- footer: connection summary and version -->
        <StackPanel Grid.Row="1" Margin="16,0,16,14" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="pulse" Width="8" Height="8" Fill="{Binding FooterBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FooterText}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock FontSize="12" Foreground="{StaticResource SubtleBrush}" Text="{Binding Version}" />
            <TextBlock FontSize="12" Foreground="{StaticResource SubtleBrush}" Text="·" />
            <TextBlock FontSize="12" Foreground="{StaticResource SubtleBrush}" Text="{Binding Tagline}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Content ===== -->
    <Grid Grid.Row="1" Grid.Column="1">
      <TransitioningContentControl Content="{Binding CurrentPage}">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.12" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </Grid>

    <!-- ===== Setup wizard: covers the content area; the title bar (drag + caption buttons) stays on top ===== -->
    <v:SetupWizardView Grid.Row="1" Grid.ColumnSpan="2" ZIndex="10" DataContext="{Binding Wizard}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowWizard}" />
  </Grid>
</Window>
