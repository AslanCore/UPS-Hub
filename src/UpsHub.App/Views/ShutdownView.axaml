<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UpsHub.App.ViewModels"
             x:Class="UpsHub.App.Views.ShutdownView"
             x:DataType="vm:ShutdownViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Grid.row > StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Spacing" Value="2" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style Selector="Grid.row TextBlock.t"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Medium" /></Style>
    <Style Selector="Grid.row TextBlock.d">
      <Setter Property="FontSize" Value="12.5" /><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid.row > :is(Control).ctl"><Setter Property="Grid.Column" Value="1" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="28,24,28,28" Spacing="16" MaxWidth="1160">
      <Grid ColumnDefinitions="*,Auto" Classes="stagger">
        <StackPanel Spacing="4">
          <TextBlock Text="PROTECT THIS PC" Classes="label" />
          <TextBlock Text="Shutdown rules" Classes="display" FontSize="32" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="When the UPS powering this PC runs low, UPS Hub counts down and then acts. Power coming back cancels the countdown." />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
          <TextBlock Text="Rules active" Classes="muted" VerticalAlignment="Center" />
          <ToggleSwitch IsChecked="{Binding Enabled}" />
        </StackPanel>
      </Grid>

      <TextBlock Text="{Binding PowerNote}" IsVisible="{Binding PowerNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="{StaticResource StatusDegradedBrush}" FontSize="12.5" />

      <!-- Action picker: PVE-style segmented tiles -->
      <Border Classes="card lg" Padding="22">
        <StackPanel Spacing="12">
          <TextBlock Text="ACTION" Classes="kicker" />
          <Grid ColumnDefinitions="*,8,*,8,*">
            <Button Classes="seg" Classes.selected="{Binding IsShutdown}" Command="{Binding SetActionCommand}" CommandParameter="Shutdown">
              <StackPanel Spacing="3"><TextBlock Text="Shut down" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="POWER OFF" Classes="segsub" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="seg" Classes.selected="{Binding IsHibernate}" Command="{Binding SetActionCommand}" CommandParameter="Hibernate">
              <StackPanel Spacing="3"><TextBlock Text="Hibernate" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="SAVE TO DISK" Classes="segsub" /></StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="seg" Classes.selected="{Binding IsSleep}" Command="{Binding SetActionCommand}" CommandParameter="Sleep">
              <StackPanel Spacing="3"><TextBlock Text="Sleep" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="LOW POWER" Classes="segsub" /></StackPanel>
            </Button>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel><TextBlock Classes="t" Text="Close apps without waiting" /><TextBlock Classes="d" Text="Like shutdown /f. Recommended, otherwise an app asking to save can block the shutdown." /></StackPanel>
            <ToggleSwitch Classes="ctl" IsChecked="{Binding ForceCloseApps}" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,16,*">
        <!-- Triggers -->
        <Border Classes="card lg" Padding="22">
          <StackPanel Spacing="6">
            <TextBlock Text="TRIGGERS · WHILE ON BATTERY" Classes="kicker" Margin="0,0,0,6" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="t" Text="UPS that powers this PC" /><TextBlock Classes="d" Text="Rules watch this UPS." /></StackPanel>
              <ComboBox Classes="ctl" MinWidth="200" ItemsSource="{Binding UpsOptions}" SelectedItem="{Binding PrimaryUps}" PlaceholderText="first UPS found" />
            </Grid>
            <Separator />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="t" Text="Battery below" /><TextBlock Classes="d" Text="Percent charge. 0 turns it off." /></StackPanel>
              <NumericUpDown Classes="ctl" Value="{Binding BatteryPercentBelow}" Minimum="0" Maximum="100" Increment="5" FormatString="0'%'" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="t" Text="Runtime below" /><TextBlock Classes="d" Text="Seconds of runtime left. 0 turns it off." /></StackPanel>
              <NumericUpDown Classes="ctl" Value="{Binding RuntimeSecondsBelow}" Minimum="0" Maximum="7200" Increment="30" FormatString="0's'" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="t" Text="On battery for" /><TextBlock Classes="d" Text="Act after this long on battery, whatever the charge. 0 turns it off." /></StackPanel>
              <NumericUpDown Classes="ctl" Value="{Binding OnBatteryForSeconds}" Minimum="0" Maximum="86400" Increment="60" FormatString="0's'" />
            </Grid>
            <Separator />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="t" Text="UPS low-battery flag (LB)" /><TextBlock Classes="d" Text="Act as soon as the UPS itself reports low battery." /></StackPanel>
              <ToggleSwitch Classes="ctl" IsChecked="{Binding OnLowBatteryFlag}" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="t" Text="Follow server shutdown (FSD)" /><TextBlock Classes="d" Text="When the NUT primary orders a forced shutdown." /></StackPanel>
              <ToggleSwitch Classes="ctl" IsChecked="{Binding FollowFsd}" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="t" Text="Lost contact while on battery" /><TextBlock Classes="d" Text="Treat a dropped connection during an outage as critical." /></StackPanel>
              <ToggleSwitch Classes="ctl" IsChecked="{Binding ActIfLost}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Countdown -->
        <Border Grid.Column="2" Classes="card lg" Padding="22" VerticalAlignment="Top">
          <StackPanel Spacing="6">
            <TextBlock Text="COUNTDOWN" Classes="kicker" Margin="0,0,0,6" />
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="t" Text="Warning time" /><TextBlock Classes="d" Text="A countdown window appears first. 0 acts immediately." /></StackPanel>
              <NumericUpDown Classes="ctl" Value="{Binding CountdownSeconds}" Minimum="0" Maximum="3600" Increment="5" FormatString="0's'" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="t" Text="Allow one extension" /><TextBlock Classes="d" Text="Shows a button that adds time once." /></StackPanel>
              <ToggleSwitch Classes="ctl" IsChecked="{Binding AllowExtension}" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding AllowExtension}">
              <StackPanel><TextBlock Classes="t" Text="Extension" /><TextBlock Classes="d" Text="Extra time added by the button." /></StackPanel>
              <NumericUpDown Classes="ctl" Value="{Binding ExtensionSeconds}" Minimum="0" Maximum="3600" Increment="30" FormatString="0's'" />
            </Grid>
            <Separator />
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" IsVisible="{Binding !ConfirmingTest}">
              <TextBlock Classes="d muted" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                         Text="{Binding TestDescription}" />
              <Button Grid.Column="1" Classes="ghost danger" Content="Test shutdown…" Command="{Binding TestCommand}" />
            </Grid>
            <TextBlock Text="{Binding TestResult}" Classes="muted" FontSize="12.5" IsVisible="{Binding !!TestResult.Length}" />
            <Border IsVisible="{Binding ConfirmingTest}" Background="{StaticResource StatusDownSoftBrush}" CornerRadius="12" Padding="16" Margin="0,4,0,0"
                    BorderBrush="{StaticResource StatusDownBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconPower}" Width="13" Height="13" Foreground="{StaticResource StatusDownBrush}" />
                  <TextBlock Text="{Binding ActionVerbUpper, StringFormat='THIS PC WILL REALLY {0}'}" Classes="kicker" Foreground="{StaticResource StatusDownBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding TestWarning}" FontSize="13" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="dangerfill" Padding="14,8" FontSize="12.5" Content="{Binding StartTestText}" Command="{Binding StartTestCommand}" />
                  <Button Classes="ghost" Padding="14,8" FontSize="12.5" Content="Don't test" Command="{Binding CancelTestCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
