<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UpsHub.App.ViewModels"
             xmlns:c="using:UpsHub.App.Controls"
             x:Class="UpsHub.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,16,32,28" Spacing="16" MaxWidth="1160">

      <!-- ===== Header: page title, live status (dot + text), device line ===== -->
      <Grid ColumnDefinitions="*,Auto" Classes="stagger">
        <StackPanel Spacing="6">
          <TextBlock Text="Dashboard" Classes="display h1" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes.pulse="{Binding PillPulse}" Width="8" Height="8" Fill="{Binding PillBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PillText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="·" Classes="subtle" VerticalAlignment="Center" IsVisible="{Binding HasData}" />
            <TextBlock Text="{Binding UpdatedText}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasData}" />
          </StackPanel>
          <TextBlock Text="{Binding Subtitle}" Classes="subtle" FontSize="12" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding DeviceText}" Classes="subtle" FontSize="12" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" IsVisible="{Binding HasData}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="Reconnect now" Command="{Binding ReconnectCommand}" IsVisible="{Binding ShowReconnect}" />
          <Button Classes="primary" Content="Add server" Command="{Binding AddServerCommand}" />
        </StackPanel>
      </Grid>

      <!-- ===== Update available (the first-run prompt moved to the setup wizard) ===== -->
      <Border Classes="card" Padding="20" DataContext="{Binding Updates}" x:DataType="vm:UpdateViewModel"
              IsVisible="{Binding ShowCard, FallbackValue=False}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding StatusKicker}" Classes="kicker" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Published}" Classes="mono subtle" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding NewVersion, StringFormat='UPS Hub {0} is ready.'}" Classes="display h2" />
            <Border Classes="panel" Padding="14,12" MaxWidth="680" HorizontalAlignment="Left" Margin="0,4,0,0">
              <ScrollViewer MaxHeight="150">
                <TextBlock Text="{Binding Notes}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource MutedBrush}" />
              </ScrollViewer>
            </Border>
            <StackPanel Spacing="6" IsVisible="{Binding IsDownloading}" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Message}" FontSize="12.5" Classes="muted" />
                <TextBlock Text="{Binding ProgressText}" Classes="mono subtle" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
              <ProgressBar Classes="scan" Value="{Binding Progress}" Maximum="1" MaxWidth="420" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left"
                       Foreground="{StaticResource StatusUpBrush}" IsVisible="{Binding IsReady}" />
            <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left"
                       Foreground="{StaticResource StatusDegradedBrush}" IsVisible="{Binding IsFailed}" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
              <Button Classes="primary" Command="{Binding InstallCommand}" IsVisible="{Binding !IsBusy}" IsEnabled="{Binding !IsReady}">
                <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconDownload}" Width="13" Height="13" /><TextBlock Text="{Binding InstallText}" /></StackPanel>
              </Button>
              <Button Content="Cancel download" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" />
              <Button Command="{Binding ReleaseNotesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="Release notes" /><PathIcon Data="{StaticResource IconOpen}" Width="10" Height="10" /></StackPanel>
              </Button>
              <Button Classes="link" Content="Skip this version" Command="{Binding SkipCommand}" IsVisible="{Binding IsAvailable}" />
              <Button Classes="link" Content="Later" Command="{Binding LaterCommand}" IsVisible="{Binding !IsBusy}" />
            </StackPanel>
            <TextBlock Classes="subtle" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="The installer is checked against the UPS Hub release signature and its SHA-256 before it runs. UPS Hub closes, updates and starts again." />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Empty state ===== -->
      <Border Classes="card" Padding="20" IsVisible="{Binding ShowEmpty}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6">
            <TextBlock Text="Get started" Classes="kicker" />
            <TextBlock Text="Connect to your NUT server" Classes="display h2" />
            <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                       Text="UPS Hub reads your UPS from a NUT server (upsd, port 3493) on your network, for example the one on your Proxmox host. Let it scan your network, or add the server by address." />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Command="{Binding FindServersCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconRadar}" Width="12" Height="12" /><TextBlock Text="Find servers" /></StackPanel>
            </Button>
            <Button Classes="primary" Command="{Binding AddServerCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" /><TextBlock Text="Add server" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== UPS switcher when several are monitored ===== -->
      <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding MultipleUps}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:UpsChipViewModel">
            <Button Classes="seg" Classes.selected="{Binding IsSelected}" Padding="14,8" HorizontalAlignment="Left"
                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" Classes="mono" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ===== Primary metrics: four cards, value + unit, thin accent bar for the two percentages ===== -->
      <Grid ColumnDefinitions="*,12,*,12,*,12,*" IsVisible="{Binding HasData}" Classes="stagger">
        <Border Classes="card" Grid.Column="0">
          <StackPanel Spacing="2">
            <TextBlock Text="Battery" Classes="muted" FontSize="12" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding BatteryText}" Classes="value" />
              <TextBlock Text="%" Classes="unit" />
            </StackPanel>
            <TextBlock Text="{Binding BatteryState}" Classes="subtle" FontSize="12" />
            <c:MeterBar Margin="0,10,0,0" Minimum="0" Maximum="100" Value="{Binding Battery}" HasValue="{Binding HasBattery}" BarBrush="{Binding BatteryBrush}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Grid.Column="2">
          <StackPanel Spacing="2">
            <TextBlock Text="Load" Classes="muted" FontSize="12" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding LoadText}" Classes="value" />
              <TextBlock Text="%" Classes="unit" />
            </StackPanel>
            <TextBlock Text="of capacity" Classes="subtle" FontSize="12" />
            <c:MeterBar Margin="0,10,0,0" Minimum="0" Maximum="100" Value="{Binding Load}" HasValue="{Binding HasLoad}" BarBrush="{Binding LoadBrush}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Grid.Column="4">
          <StackPanel Spacing="2">
            <TextBlock Text="Runtime" Classes="muted" FontSize="12" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding RuntimeText}" Classes="value" />
              <TextBlock Text="{Binding RuntimeUnit}" Classes="unit" />
            </StackPanel>
            <TextBlock Text="{Binding RuntimeNote}" Classes="subtle" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RuleText}" Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Classes="card" Grid.Column="6">
          <StackPanel Spacing="2">
            <TextBlock Text="Power" Classes="muted" FontSize="12" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding WattsText}" Classes="value" />
              <TextBlock Text="W" Classes="unit" />
            </StackPanel>
            <TextBlock Text="{Binding WattsNote}" Classes="subtle" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Classes="subtle" FontSize="12" Margin="0,8,0,0" Text="{Binding FlagsText, StringFormat='ups.status  {0}'}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ===== Electrical rows + history ===== -->
      <Grid ColumnDefinitions="*,12,*" IsVisible="{Binding HasData}" Classes="stagger">
        <Border Classes="card" Padding="16,12,16,8">
          <StackPanel>
            <TextBlock Text="Electrical" Classes="muted" FontSize="12" Margin="0,0,0,6" />
            <Grid ColumnDefinitions="*,Auto" Height="38">
              <TextBlock Text="Input voltage" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding InputVText}" FontWeight="SemiBold" /><TextBlock Text="V" FontWeight="SemiBold" /></StackPanel>
            </Grid>
            <Separator Margin="0" />
            <Grid ColumnDefinitions="*,Auto" Height="38">
              <TextBlock Text="Output voltage" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding OutputVText}" FontWeight="SemiBold" /><TextBlock Text="V" FontWeight="SemiBold" /></StackPanel>
            </Grid>
            <Separator Margin="0" />
            <Grid ColumnDefinitions="*,Auto" Height="38">
              <TextBlock Text="Battery voltage" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding BatteryVText}" FontWeight="SemiBold" /><TextBlock Text="V" FontWeight="SemiBold" /></StackPanel>
            </Grid>
            <Separator Margin="0" />
            <Grid ColumnDefinitions="*,Auto" Height="38">
              <TextBlock Text="Frequency" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding FreqText}" FontWeight="SemiBold" /><TextBlock Text="Hz" FontWeight="SemiBold" /></StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card">
          <Grid RowDefinitions="Auto,*,Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Battery history" Classes="muted" FontSize="12" />
              <TextBlock Grid.Column="1" Text="Last 3 min" Classes="subtle" FontSize="12" />
            </Grid>
            <c:Sparkline Grid.Row="1" Margin="0,8,0,12" MinHeight="64" Points="{Binding ChargeHistory}" LineColor="#6CCB5F" />
            <TextBlock Grid.Row="2" Text="Load history" Classes="muted" FontSize="12" />
            <c:Sparkline Grid.Row="3" Margin="0,8,0,0" MinHeight="64" Points="{Binding LoadHistory}" LineColor="#D0D0D0" />
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
