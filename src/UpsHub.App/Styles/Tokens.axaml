<!--
  Design tokens: Windows 11 (Fluent 2) dark layers with a single accent.
  Key names are kept from earlier versions so views and styles keep resolving.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Layers: base (Mica-like) / inset / card / card hover -->
  <Color x:Key="ColorBg">#202020</Color>
  <Color x:Key="ColorSurface">#1C1C1C</Color>
  <Color x:Key="ColorElevated">#272727</Color>
  <Color x:Key="ColorElevated2">#2D2D2D</Color>
  <Color x:Key="ColorForeground">#FFFFFF</Color>
  <Color x:Key="ColorMuted">#C5C5C5</Color>
  <Color x:Key="ColorSubtle">#9D9D9D</Color>
  <!-- Accent: primary buttons, selected-nav indicator, progress/battery fill, focus -->
  <Color x:Key="ColorPrimary">#FF5C1A</Color>
  <Color x:Key="ColorPrimaryHover">#FF7336</Color>
  <Color x:Key="ColorPrimaryPressed">#E04E12</Color>
  <Color x:Key="ColorPrimaryForeground">#111111</Color>
  <!-- 1px strokes -->
  <Color x:Key="ColorBorder">#14FFFFFF</Color>
  <Color x:Key="ColorRing">#1AFFFFFF</Color>
  <Color x:Key="ColorRingHover">#26FFFFFF</Color>
  <!-- Status: dot + text only -->
  <Color x:Key="ColorStatusUp">#6CCB5F</Color>
  <Color x:Key="ColorStatusDegraded">#F5A524</Color>
  <Color x:Key="ColorStatusDown">#FF6B6B</Color>
  <Color x:Key="ColorMeter">#FF5C1A</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource ColorBg}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ColorElevated}" />
  <SolidColorBrush x:Key="Elevated2Brush" Color="{StaticResource ColorElevated2}" />
  <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ColorForeground}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorMuted}" />
  <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource ColorSubtle}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource ColorPrimaryHover}" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource ColorPrimaryPressed}" />
  <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource ColorPrimaryForeground}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
  <SolidColorBrush x:Key="RingBrush" Color="{StaticResource ColorRing}" />
  <SolidColorBrush x:Key="StatusUpBrush" Color="{StaticResource ColorStatusUp}" />
  <SolidColorBrush x:Key="StatusDegradedBrush" Color="{StaticResource ColorStatusDegraded}" />
  <SolidColorBrush x:Key="StatusDownBrush" Color="{StaticResource ColorStatusDown}" />
  <SolidColorBrush x:Key="MeterBrush" Color="{StaticResource ColorMeter}" />
  <!-- Selected / hovered list rows (Fluent subtle fill) -->
  <SolidColorBrush x:Key="SubtleFillBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="SubtleFillSelectedBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="StrokeStrongBrush" Color="#8BFFFFFF" />

  <!-- Fonts: Segoe UI Variable on Windows 11, Segoe UI on Windows 10, Inter or the system sans elsewhere -->
  <FontFamily x:Key="FontSans">Segoe UI Variable Text, Segoe UI Variable, Segoe UI, Inter, sans-serif</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI Variable, Segoe UI, Inter, sans-serif</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>

  <!-- Fluent 2 radii: control 4, card 8, flyout / dialog 8 -->
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">4</CornerRadius>
  <CornerRadius x:Key="RadiusLg">8</CornerRadius>
  <CornerRadius x:Key="RadiusXl">8</CornerRadius>

  <!-- No glows: the "shadow" keys are only 1px strokes now -->
  <BoxShadows x:Key="ShadowBorder">0 0 0 1 #14FFFFFF</BoxShadows>
  <BoxShadows x:Key="ShadowBorderHover">0 0 0 1 #26FFFFFF</BoxShadows>
  <BoxShadows x:Key="ShadowGlow">0 0 0 1 #14FFFFFF</BoxShadows>
  <BoxShadows x:Key="ShadowRed">0 0 0 1 #26FFFFFF</BoxShadows>

  <!-- Motion: Fluent standard easing -->
  <SplineEasing x:Key="EaseOut" X1="0.0" Y1="0.0" X2="0.0" Y2="1.0" />
</ResourceDictionary>
