<!-- Windows 11 (Fluent 2) look for native controls: neutral layers, 1px strokes, 4/8px radii, one accent. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Base ===== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- ===== Type (Fluent type ramp: caption 12, body 14, subtitle 20, title 28) ===== -->
  <!-- Small section headings: sentence case, no tracking, no accent colour -->
  <Style Selector="TextBlock.kicker">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
  </Style>
  <Style Selector="TextBlock.kicker.accent"><Setter Property="Foreground" Value="{StaticResource SubtleBrush}" /></Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="28" /></Style>
  <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="18" /></Style>
  <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="16" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></Style>
  <Style Selector="TextBlock.subtle"><Setter Property="Foreground" Value="{StaticResource SubtleBrush}" /></Style>
  <!-- Fluent apps use the UI font for identifiers too; the monospace font is only for code blocks -->
  <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="{StaticResource FontSans}" /></Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="30" />
  </Style>
  <Style Selector="TextBlock.unit">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="4,0,0,4" />
  </Style>

  <!-- ===== Surfaces ===== -->
  <!-- card: layered fill, 1px stroke, 8px radius, no shadow -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.card.lg"><Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" /></Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.glow"><Setter Property="BoxShadow" Value="none" /></Style>
  <Style Selector="Border.squircle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- status: a small dot + text, no filled pill -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,6" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="#0FFFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="BorderBrush" Value="#17FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#15FFFFFF" />
    <Setter Property="BorderBrush" Value="#17FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#08FFFFFF" />
    <Setter Property="BorderBrush" Value="#12FFFFFF" />
    <Setter Property="Foreground" Value="#C5C5C5" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0BFFFFFF" />
    <Setter Property="BorderBrush" Value="#12FFFFFF" />
    <Setter Property="Foreground" Value="#5D5D5D" />
  </Style>

  <!-- Accent (primary) button -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#28FFFFFF" />
    <Setter Property="BorderBrush" Value="#12FFFFFF" />
    <Setter Property="Foreground" Value="#8B8B8B" />
  </Style>

  <!-- Standard button (same as the default look; kept as a class for existing views) -->
  <Style Selector="Button.ghost" />
  <Style Selector="Button.ghost.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource StatusDownBrush}" />
  </Style>

  <!-- Destructive confirm: solid red -->
  <Style Selector="Button.dangerfill">
    <Setter Property="Background" Value="#C42B1C" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
  </Style>
  <Style Selector="Button.dangerfill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D13A2B" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.dangerfill:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#A82418" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Text button -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0FFFFFFF" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#08FFFFFF" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- NavigationView item: 36px row, subtle fill when selected, 3px accent indicator on the left -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="14,0,12,0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="NavFill" Background="{TemplateBinding Background}" CornerRadius="4" />
          <Border x:Name="NavIndicator" IsVisible="False" Width="3" Height="16" CornerRadius="2"
                  Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
          <ContentPresenter x:Name="NavContent" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.nav:pointerover /template/ Border#NavFill"><Setter Property="Background" Value="#0FFFFFFF" /></Style>
  <Style Selector="Button.nav:pressed /template/ Border#NavFill"><Setter Property="Background" Value="#08FFFFFF" /></Style>
  <Style Selector="Button.nav.active /template/ Border#NavFill"><Setter Property="Background" Value="#14FFFFFF" /></Style>
  <Style Selector="Button.nav.active /template/ Border#NavIndicator"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="Button.nav.active"><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style Selector="Button.nav PathIcon">
    <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>

  <!-- Segmented choices (keyboard / mode / UPS pickers) -->
  <Style Selector="Button.seg">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="Button.seg.selected">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>
  <Style Selector="Button.seg.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>
  <Style Selector="Button.seg.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#26FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>
  <Style Selector="Button.seg TextBlock.segsub">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.8" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Title bar caption buttons: 46x32 like Windows 11 -->
  <Style Selector="Button.caption">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0AFFFFFF" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#B22A1B" />
    <Setter Property="Foreground" Value="#E0E0E0" />
  </Style>
  <Style Selector="Button.caption PathIcon"><Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" /></Style>

  <!-- ===== Inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="#0FFFFFFF" />
    <Setter Property="BorderBrush" Value="#17FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="SelectionBrush" Value="#66FF5C1A" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#15FFFFFF" />
    <Setter Property="BorderBrush" Value="#17FFFFFF" />
  </Style>
  <!-- Fluent text box: 2px accent line under the field while it has focus -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#1C1C1C" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
  </Style>
  <Style Selector="TextBox.mono"><Setter Property="FontFamily" Value="{StaticResource FontSans}" /></Style>

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="#0FFFFFFF" />
    <Setter Property="BorderBrush" Value="#17FFFFFF" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="MinWidth" Value="130" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="#0FFFFFFF" />
    <Setter Property="BorderBrush" Value="#17FFFFFF" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="#15FFFFFF" />
    <Setter Property="BorderBrush" Value="#17FFFFFF" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="#2D2D2D" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderBrush" Value="#26FFFFFF" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ===== Motion: a plain fade-in on page load ===== -->
  <Style Selector=":is(Control).stagger">
    <Style.Animations>
      <Animation Duration="0:0:0.2" Easing="{StaticResource EaseOut}" FillMode="Backward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- status dot: one short fade when the state changes (class added), then static.
       Never loop animations here: a looping animation makes the compositor redraw every frame (GPU + DWM load). -->
  <Style Selector="Ellipse.pulse">
    <Style.Animations>
      <Animation Duration="0:0:0.6" IterationCount="1" Easing="{StaticResource EaseOut}">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- In-app toasts -->
  <Style Selector="NotificationCard">
    <Setter Property="Background" Value="#2D2D2D" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="#26FFFFFF" />
    <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
  </Style>

  <!-- progress: thin bar, accent fill, no glow -->
  <Style Selector="ProgressBar.scan">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="#3A3A3A" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
  </Style>
  <Style Selector="ProgressBar.scan /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <!-- code snippets in the troubleshooting panel -->
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.code SelectableTextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>
  <!-- numbered steps: a plain circle, no tint -->
  <Style Selector="Border.step">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.step TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- small tag: outlined, neutral -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
</Styles>
