<!-- AslanCore look for native controls. Mirrors the utility classes used across the Cloud / PVE pages. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Base ===== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- ===== Type ===== -->
  <!-- .text-kicker .tracking-kicker .font-mono .uppercase -->
  <Style Selector="TextBlock.kicker">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="LetterSpacing" Value="2.3" />
    <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
  </Style>
  <Style Selector="TextBlock.kicker.accent"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="1.6" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.5" />
  </Style>
  <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="44" /><Setter Property="LetterSpacing" Value="-1" /></Style>
  <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="20" /></Style>
  <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="16" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></Style>
  <Style Selector="TextBlock.subtle"><Setter Property="Foreground" Value="{StaticResource SubtleBrush}" /></Style>
  <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="{StaticResource FontMono}" /></Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="LetterSpacing" Value="-0.5" />
  </Style>
  <Style Selector="TextBlock.unit">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="4,0,0,4" />
  </Style>

  <!-- ===== Surfaces ===== -->
  <!-- rounded-xl bg-surface shadow-border -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
    <Setter Property="BoxShadow" Value="{StaticResource ShadowBorder}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.card.lg"><Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" /></Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.glow">
    <Setter Property="BoxShadow" Value="{StaticResource ShadowGlow}" />
  </Style>
  <!-- squircle logo tile (border-radius 22.5%) -->
  <Style Selector="Border.squircle">
    <Setter Property="Background" Value="#000000" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- status pill: bg-status-up/15 text-status-up rounded-full -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{StaticResource StatusUpSoftBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" Easing="{StaticResource EaseOut}" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <!-- press: scale 0.97 on active -->
  <Style Selector="Button:pressed"><Setter Property="RenderTransform" Value="scale(0.97)" /></Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Elevated2Brush}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Elevated2Brush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #40FF5C1A" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{StaticResource ShadowBorderHover}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Elevated2Brush}" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource StatusDownSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource StatusDownBrush}" />
  </Style>

  <!-- Destructive confirm: solid red -->
  <Style Selector="Button.dangerfill">
    <Setter Property="Background" Value="{StaticResource StatusDownBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.dangerfill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F05A48" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #40E24B3A" />
  </Style>
  <Style Selector="Button.dangerfill:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource StatusDownBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Sidebar nav: Home / Apps / Status ... -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>
  <Style Selector="Button.nav PathIcon">
    <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>

  <!-- Segmented tiles (PVE "Start from" / keyboard pickers) -->
  <Style Selector="Button.seg">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,10" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="Button.seg.selected">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
  </Style>
  <Style Selector="Button.seg.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
  </Style>
  <Style Selector="Button.seg TextBlock.segsub">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="Opacity" Value="0.8" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Title bar caption buttons -->
  <Style Selector="Button.caption">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E81123" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.caption PathIcon"><Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" /></Style>

  <!-- ===== Inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="#59FF5C1A" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="#33F3F1EE" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.mono"><Setter Property="FontFamily" Value="{StaticResource FontMono}" /></Style>

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="MinWidth" Value="130" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource Elevated2Brush}" />
    <Setter Property="BorderBrush" Value="#33F3F1EE" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
  </Style>

  <!-- ===== Page transitions: stagger-in (fade + 8px rise) ===== -->
  <Style Selector=":is(Control).stagger">
    <Style.Animations>
      <Animation Duration="0:0:0.4" Easing="{StaticResource EaseOut}" FillMode="Backward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- live dot: one short flash when the state changes (class added), then static.
       Never loop animations here: a looping animation makes the compositor redraw every frame (GPU + DWM load). -->
  <Style Selector="Ellipse.pulse">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="1" Easing="{StaticResource EaseOut}">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- In-app toasts -->
  <Style Selector="NotificationCard">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
  </Style>
  <!-- text-style button (Not now, Login...) -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>

  <!-- scan progress: orange bar with a soft glow -->
  <Style Selector="ProgressBar.scan">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
  </Style>
  <Style Selector="ProgressBar.scan /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 14 1 #99FF5C1A" />
  </Style>

  <!-- code snippets in the troubleshooting panel -->
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.code SelectableTextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
  </Style>
  <Style Selector="Border.step">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.step TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
</Styles>