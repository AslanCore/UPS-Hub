<Project>
  <!--
    Branding lives here and only here. Rename the app by changing these
    properties; AppInfo reads them back at runtime through assembly metadata.
  -->
  <PropertyGroup>
    <AppDisplayName>UPS Hub</AppDisplayName>
    <AppPublisher>AslanCore</AppPublisher>
    <AppTagline>by AslanCore</AppTagline>
    <AppId>AslanCore.UpsHub</AppId>
    <AppRepoUrl>https://github.com/AslanCore/UPS-Hub</AppRepoUrl>
    <Version>0.5.0</Version>

    <Product>$(AppDisplayName)</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>$(AppPublisher)</Company>
    <Copyright>Copyright (C) 2026 $(AppPublisher). Portions (C) WinNUT-Client contributors. GPL-3.0-or-later.</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppDisplayName</_Parameter1><_Parameter2>$(AppDisplayName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppPublisher</_Parameter1><_Parameter2>$(AppPublisher)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppTagline</_Parameter1><_Parameter2>$(AppTagline)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppId</_Parameter1><_Parameter2>$(AppId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppRepoUrl</_Parameter1><_Parameter2>$(AppRepoUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
